---
import Brand from "./Brand.astro";

interface Props {
  /** Project segment of the breadcrumb brand: `cheeselord.dev / <project>`. */
  project: string;
  /** Where the project segment links; defaults to this site's root. */
  projectHref?: string;
}

const { project, projectHref } = Astro.props;
---
<header class="cheeselord-header">
  <Brand project={project} projectHref={projectHref} />
  <slot />
  <slot name="actions" />
</header>
