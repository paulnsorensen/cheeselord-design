{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cheeselord flavor",
  "type": "object",
  "required": ["name", "accents", "socialCard"],
  "additionalProperties": false,
  "properties": {
    "name": { "enum": ["easy-cheese", "hallouminate", "cheeselord"] },
    "accents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accent", "accentMuted", "accentStrong"],
      "properties": {
        "accent": { "$ref": "#/$defs/color" },
        "accentMuted": { "$ref": "#/$defs/color" },
        "accentStrong": { "$ref": "#/$defs/color" },
        "accentAlt": { "$ref": "#/$defs/color" }
      }
    },
    "typography": { "type": "object", "additionalProperties": false },
    "surfaces": { "type": "object", "additionalProperties": false, "properties": { "paper": { "$ref": "#/$defs/color" }, "ink": { "$ref": "#/$defs/color" } } },
    "socialCard": { "type": "object", "required": ["composition"], "additionalProperties": false, "properties": { "composition": { "enum": ["workshop", "signal", "monument"] } } }
  },
  "$defs": {
    "color": { "pattern": "^(#[0-9A-Fa-f]{6}|oklch\\((\\d{1,2}(\\.\\d+)?|100)% 0(\\.\\d+)? \\d{1,3}(\\.\\d+)?\\))$" }
  }
}
